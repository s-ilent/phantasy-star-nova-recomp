# game and firmware data -- decrypted titles, firmware, recompiled game C and images, captures, saves,
# settings: local to each machine, never committed (vitarecomp reads it from dump/)
dump/
# the repository's Python environment (./vitarecomp setup)
.venv/
__pycache__/
.DS_Store
# build outputs: Dear ImGui's objects, gfxreplay and the other tools, the gate's logs; the launcher beside its source
build/
launcher/nativ
launcher/nativ.exe
launcher/SDL3.dll
launcher/obj_win/
# agent worktrees
.claude/
# kept on each machine, not shared: plans that aren't the project's yet, and this machine's defaults for the dev scripts
docs/android.md
dev/local.env

# local research tools (Java, Ghidra) and their project
tools/
# this machine's Windows toolchain (runtime/platform/win/setup-toolchain.sh) and Sony's firmware file: never committed
toolchain/
*.PUP
*.pup

# Phantasy Star Nova: stage logs of dev/psn_build_all.sh (local)
dev/psn-logs/
# ... and pictures of the game (screenshots, atlases rendered from its files): the game's own imagery stays local
docs/psnova/*.png
dev/psnova/rmd/samples/
# local rollback copies made before risky edits (kept on disk, never committed)
pipeline/vitarecomp.py.before-tee-fix
runtime/gfx/gfx_dispatch.c.before-deferdraws
runtime/gfx/gfx_gpu.c.before-depthclip
runtime/gfx/gfx_gpu.c.before-gpulines
dev/psnova/rmdtext/rmdlib_v1_before_8082fix.py
dev/psnova/uitex/specwork/apply_spec.before-bc1.py
# a pack's localization draws with a font: yours stays local and is never committed, except the default the project
# ships (SIL OFL, packs/PCSG00351/english/fonts), so a build needs no font of your own
packs/*/english/fonts/*.ttf
packs/*/english/fonts/*.otf
!packs/*/english/fonts/K2D-*.ttf
